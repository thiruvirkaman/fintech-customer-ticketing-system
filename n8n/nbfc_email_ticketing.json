    {
      "parameters": {
        "jsCode": "const source = $json;\nconst rawHeaders = source.payload?.headers ?? source.headers ?? {};\nconst header = (name) => {\n  if (Array.isArray(rawHeaders)) {\n    const match = rawHeaders.find((entry) => String(entry.name ?? '').toLowerCase() === name.toLowerCase());\n    if (match?.value) return String(match.value);\n  }\n  if (rawHeaders && typeof rawHeaders === 'object') {\n    const key = Object.keys(rawHeaders).find((item) => item.toLowerCase() === name.toLowerCase());\n    if (key) {\n      const value = rawHeaders[key];\n      return typeof value === 'object' ? String(value?.value ?? '') : String(value ?? '');\n    }\n  }\n  return String(source[name] ?? source[name.toLowerCase()] ?? '');\n};\nconst findPlainPart = (parts) => {\n  if (!Array.isArray(parts)) return '';\n  for (const part of parts) {\n    if (part.mimeType === 'text/plain' && part.body?.data) return part.body.data;\n    const nested = findPlainPart(part.parts);\n    if (nested) return nested;\n  }\n  return '';\n};\nconst decodeBase64Url = (value) => {\n  if (!value) return '';\n  const normalizedValue = String(value).replace(/-/g, '+').replace(/_/g, '/');\n  return Buffer.from(normalizedValue, 'base64').toString('utf8');\n};\nconst from = header('From');\nconst sender = (from.match(/<([^>]+)>/)?.[1] ?? from).trim();\nconst encodedBody = source.payload?.body?.data ?? findPlainPart(source.payload?.parts);\nconst body = source.textPlain || source.text || (encodedBody ? decodeBase64Url(encodedBody) : '') || source.snippet || '';\nconst normalized = {\n  gmail_message_id: String(source.id ?? source.messageId ?? '').trim(),\n  gmail_thread_id: String(source.threadId ?? source.thread_id ?? '').trim(),\n  sender_email: sender,\n  subject: header('Subject'),\n  body_text: String(body).trim(),\n  received_at: source.internalDate ? new Date(Number(source.internalDate)).toISOString() : new Date().toISOString()\n};\nfor (const field of ['gmail_message_id', 'gmail_thread_id', 'sender_email', 'body_text']) {\n  if (!normalized[field]) throw new Error(`Gmail payload is missing ${field}`);\n}\nreturn [{ json: normalized }];"
      },
